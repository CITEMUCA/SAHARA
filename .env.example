# Copier ce fichier en .env puis adapter les valeurs.
PORT=3000

# Mot de passe de l'espace organisateurs (/admin). Obligatoire en production.
ADMIN_PASSWORD=changez-moi-avec-un-mot-de-passe-long

# Date et heure de clôture des candidatures (heure du Maroc, UTC+1).
REG_DEADLINE=2026-10-18T23:59:59+01:00

# Taille maximale du dossier de présentation, en Mo.
MAX_FILE_MB=5

# Connexion PostgreSQL. Créez la base sic2026 avant le premier lancement.
# Si le mot de passe contient @, encodez-le en %40 dans l'URL.
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@127.0.0.1:5432/sic2026

# Dossier des fichiers déposés.
DATA_DIR=data
